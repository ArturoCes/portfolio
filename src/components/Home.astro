---
import Icon from './Icon.astro';
import Avatar from './Avatar.astro';
import {
  type Lang,
  education,
  experience,
  languages,
  profile,
  projects,
  skills,
  ui,
  yearsOfExperience,
} from '../data/content';
import { icons } from '../data/icons';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const base = lang === 'es' ? '/proyectos/' : '/en/projects/';
const stats = [
  { value: `${yearsOfExperience()}+`, label: t.years },
  { value: String(experience.length), label: t.companies },
  { value: String(projects.length), label: t.liveProjects },
];
---

<main class="mx-auto max-w-6xl px-4 py-8 sm:py-14">
  <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
    <!-- Presentación -->
    <section class="card reveal md:col-span-2 lg:col-span-3 flex flex-col gap-6 sm:flex-row sm:items-center" style="--i:0">
      <div class="flex-1 min-w-0">
        <div class="flex items-center justify-between gap-3">
          <p class="text-xs text-muted">{t.welcome}</p>
          <a
            href={t.langHref}
            hreflang={lang === 'es' ? 'en' : 'es'}
            class="rounded-full border border-line px-3 py-1 text-xs font-semibold text-muted hover:text-white hover:border-white/30"
          >
            {t.langSwitch}
          </a>
        </div>
        <h1 class="mt-3 text-[1.35rem] leading-snug sm:text-2xl">
          {t.hello} <strong class="font-extrabold">{profile.name}</strong>,
          <span class="gradient-text font-bold"> {t.role}</span>
          <span class="text-zinc-300"> {t.intro}</span>
        </h1>
        <p class="mt-4 text-[0.95rem] leading-relaxed text-zinc-400">{t.now}</p>

        <p class="mt-5 inline-flex items-center gap-2 rounded-full bg-emerald-500/10 px-3 py-1 text-xs font-semibold text-emerald-300">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-60"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
          </span>
          {t.available} · {profile.location[lang]}
        </p>

        <div class="mt-6 flex flex-wrap gap-2.5">
          <a class="btn-icon" href={profile.github} target="_blank" rel="noopener" aria-label="GitHub">
            <Icon name="github" size={18} mono /> GitHub
          </a>
          <a class="btn-icon" href={profile.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
            <Icon name="linkedin" size={18} mono /> LinkedIn
          </a>
          <a class="btn-icon" href={profile.cv} download>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0-4-4m4 4 4-4M5 21h14" /></svg>
            {t.downloadCv}
          </a>
          <a class="btn-icon" href={`mailto:${profile.email}`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
            {t.writeMe}
          </a>
        </div>
      </div>
      <Avatar />
    </section>

    <!-- Experiencia -->
    <section class="card reveal lg:row-span-3 lg:col-start-4 lg:row-start-1" style="--i:1">
      <h2 class="card-title">{t.experience}</h2>
      <ol class="mt-5 space-y-5 border-l border-line pl-5">
        {experience.map((job, i) => (
          <li class="relative">
            <span
              class:list={[
                'absolute -left-[1.6rem] top-1.5 h-3 w-3 rounded-full border-2 border-card',
                i === 0 ? 'bg-emerald-400 shadow-[0_0_0_4px_rgba(52,211,153,0.15)]' : 'bg-zinc-600',
              ]}
            ></span>
            <p class="text-[0.7rem] font-semibold uppercase tracking-wider text-muted">
              {job.from[lang]} — {job.to ? job.to[lang] : t.present}
            </p>
            <h3 class="mt-1 font-bold leading-tight">{job.role[lang]}</h3>
            <p class="text-sm font-semibold text-violet-300">{job.company}</p>
            <p class="mt-1.5 text-[0.82rem] leading-relaxed text-zinc-400">{job.summary[lang]}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- Tecnologías -->
    <section class="card reveal lg:row-span-2" style="--i:2">
      <h2 class="card-title">{t.tech}</h2>
      <div class="mt-4 space-y-5">
        {skills.map((group) => (
          <div>
            <p class="text-[0.7rem] font-semibold uppercase tracking-wider text-muted">{group.group[lang]}</p>
            <ul class="mt-2.5 grid grid-cols-2 gap-2">
              {group.items.map((key) => (
                <li class="flex items-center gap-2 rounded-xl bg-card-2 px-2.5 py-2">
                  <Icon name={key} size={16} class="shrink-0" />
                  <span class="truncate text-[0.8rem] font-semibold">{icons[key].title}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Proyectos -->
    <section class="card reveal md:col-span-2 lg:row-span-2" style="--i:3" id="proyectos">
      <div class="flex items-baseline justify-between gap-3">
        <h2 class="card-title">{t.projects}</h2>
        <p class="text-xs text-muted">{t.projectsHint}</p>
      </div>
      <ul class="mt-4 space-y-3">
        {projects.map((p) => (
          <li>
            <article class="group relative grid gap-4 rounded-2xl border border-line bg-card-2 p-3 transition hover:border-violet-400/40 sm:grid-cols-[200px_1fr]">
              <a href={`${base}${p.slug}/`} class="block overflow-hidden rounded-xl" aria-label={`${t.details}: ${p.name}`}>
                <img
                  src={p.image}
                  alt=""
                  loading="lazy"
                  width="400"
                  height="250"
                  class="aspect-[16/10] w-full object-cover object-top transition duration-500 group-hover:scale-105"
                />
              </a>
              <div class="flex min-w-0 flex-col">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="text-lg font-bold">
                    <a href={`${base}${p.slug}/`} class="after:absolute after:inset-0 sm:after:hidden hover:text-violet-300">{p.name}</a>
                  </h3>
                  {p.status && (
                    <span class="rounded-full bg-white/5 px-2 py-0.5 text-[0.68rem] font-semibold text-zinc-400">{p.status[lang]}</span>
                  )}
                </div>
                <p class="mt-1 text-sm text-zinc-400">{p.tagline[lang]}</p>
                <div class="mt-3 flex flex-wrap items-center gap-2.5">
                  {p.tech.map((k) => <Icon name={k} size={18} />)}
                </div>
                <div class="relative z-10 mt-auto flex flex-wrap gap-2 pt-3">
                  {p.links.slice(0, 3).map((l) => (
                    <a
                      href={l.href}
                      target="_blank"
                      rel="noopener"
                      class="inline-flex items-center gap-1 rounded-lg border border-line px-2.5 py-1 text-xs font-semibold text-zinc-300 hover:border-violet-400/60 hover:text-white"
                    >
                      {l.label[lang]} <span aria-hidden="true">↗</span>
                    </a>
                  ))}
                  {p.privateCode && (
                    <span class="inline-flex items-center rounded-lg px-2.5 py-1 text-xs text-zinc-500">{t.privateCode}</span>
                  )}
                  <a href={`${base}${p.slug}/`} class="ml-auto inline-flex items-center gap-1 rounded-lg px-2.5 py-1 text-xs font-semibold text-violet-300 hover:text-violet-200">
                    {t.details} <span aria-hidden="true">→</span>
                  </a>
                </div>
              </div>
            </article>
          </li>
        ))}
      </ul>
    </section>

    <!-- Cifras -->
    <section class="card reveal" style="--i:4">
      <ul class="grid h-full grid-cols-3 gap-2 lg:grid-cols-1">
        {stats.map((s) => (
          <li class="flex flex-col justify-center lg:flex-row lg:items-baseline lg:gap-3">
            <span class="gradient-text text-3xl font-extrabold">{s.value}</span>
            <span class="text-xs leading-tight text-zinc-400 lg:text-sm">{s.label}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- Formación -->
    <section class="card reveal" style="--i:5">
      <h2 class="card-title">{t.education}</h2>
      <p class="mt-3 font-semibold leading-snug">{education.title[lang]}</p>
      <p class="mt-1 text-sm text-zinc-400">{education.school}</p>
      <p class="mt-3 inline-block rounded-full bg-violet-500/10 px-2.5 py-0.5 text-xs font-semibold text-violet-300">{education.year}</p>
    </section>

    <!-- Idiomas -->
    <section class="card reveal" style="--i:6">
      <h2 class="card-title">{t.languages}</h2>
      <ul class="mt-4 space-y-4">
        {languages.map((l) => (
          <li>
            <div class="flex items-baseline justify-between gap-2 text-sm">
              <span class="font-semibold">{l.name[lang]}</span>
              <span class="text-xs text-zinc-400">{l.level[lang]}</span>
            </div>
            <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-white/5">
              <div class="h-full rounded-full bg-gradient-to-r from-violet-500 to-cyan-400" style={`width:${l.value}%`}></div>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- Contacto -->
    <section class="card reveal" style="--i:7">
      <h2 class="card-title">{t.contact}</h2>
      <p class="mt-2 text-sm text-zinc-400">{t.contactText}</p>
      <a href={`mailto:${profile.email}`} class="mt-4 block truncate text-sm font-semibold text-violet-300 hover:text-violet-200">{profile.email}</a>
      <button
        type="button"
        class="btn-icon mt-3 w-full justify-center"
        data-copy={profile.email}
        data-copied={t.copied}
      >
        {t.copy}
      </button>
    </section>
  </div>

  <footer class="mt-4 card reveal text-center text-xs text-zinc-500" style="--i:8">
    {t.footer} <span class="text-zinc-300">{profile.name}</span> · {new Date().getFullYear()}
  </footer>
</main>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const original = btn.textContent;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        btn.textContent = btn.dataset.copied ?? '✓';
        setTimeout(() => (btn.textContent = original), 1800);
      } catch {
        location.href = `mailto:${btn.dataset.copy}`;
      }
    });
  });
</script>
