---
import Icon from './Icon.astro';

// Monograma con las tecnologías principales orbitando alrededor.
// Si algún día quieres poner tu foto, cambia el bloque central por <img src="/me.jpg" ...>.
const orbit = ['springboot', 'angular', 'flutter', 'java', 'postgresql', 'docker'];
---

<div class="relative mx-auto h-44 w-44 shrink-0 sm:h-48 sm:w-48" aria-hidden="true">
  <div class="absolute inset-0 rounded-full border border-dashed border-white/10"></div>
  <div class="orbit absolute inset-0">
    {orbit.map((name, i) => (
      <span
        class="orbit-item absolute left-1/2 top-1/2 grid h-9 w-9 place-items-center rounded-xl border border-line bg-card-2 shadow-lg"
        style={`--angle:${(360 / orbit.length) * i}deg`}
      >
        <span class="counter grid place-items-center"><Icon name={name} size={18} /></span>
      </span>
    ))}
  </div>
  <div class="absolute inset-7 grid place-items-center rounded-[2rem] bg-gradient-to-br from-violet-500 via-fuchsia-500 to-cyan-400 p-[2px] shadow-[0_0_60px_-10px_rgba(139,92,246,0.7)] sm:inset-8">
    <div class="grid h-full w-full place-items-center rounded-[calc(2rem-2px)] bg-card">
      <span class="gradient-text text-5xl font-extrabold tracking-tight">AC</span>
    </div>
  </div>
</div>

<style>
  .orbit-item {
    transform: translate(-50%, -50%) rotate(var(--angle)) translateY(-5.6rem) rotate(calc(-1 * var(--angle)));
  }
  @media (min-width: 640px) {
    .orbit-item {
      transform: translate(-50%, -50%) rotate(var(--angle)) translateY(-6.1rem) rotate(calc(-1 * var(--angle)));
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .orbit {
      animation: spin 40s linear infinite;
    }
    .counter {
      animation: spin 40s linear infinite reverse;
    }
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
