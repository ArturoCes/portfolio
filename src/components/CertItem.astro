---
import type { Lang } from '../data/content';
import { type Cert, formatDate, issuers } from '../data/certifications';

interface Props {
  cert: Cert;
  lang: Lang;
}

const { cert, lang } = Astro.props;
const issuer = issuers[cert.issuer];
const verify = lang === 'es' ? 'Ver credencial' : 'View credential';
const hours = cert.hours ? `${cert.hours.toLocaleString(lang === 'es' ? 'es-ES' : 'en-GB')} h` : null;
---

<a
  href={cert.url}
  target="_blank"
  rel="noopener"
  class="group flex h-full items-start gap-3 rounded-2xl border border-line bg-card-2 p-3.5 transition hover:border-violet-400/50"
  data-cert
  data-category={cert.category}
  data-search={`${cert.title} ${issuer.name}`.toLowerCase()}
>
  <span
    class="grid h-10 w-10 shrink-0 place-items-center rounded-xl text-[0.7rem] font-extrabold text-white"
    style={`background:${issuer.color}`}
    aria-hidden="true"
  >
    {issuer.short}
  </span>
  <span class="min-w-0 flex-1">
    <span class="block text-sm font-bold leading-snug group-hover:text-violet-200">{cert.title}</span>
    <span class="mt-1 block text-xs text-zinc-400">
      {issuer.name} · {formatDate(cert.date, lang)}{hours && ` · ${hours}`}
    </span>
    {cert.badge && (
      <span class="mt-2 inline-block rounded-full bg-emerald-500/10 px-2 py-0.5 text-[0.7rem] font-semibold text-emerald-300">
        {cert.badge[lang]}
      </span>
    )}
  </span>
  <span class="shrink-0 text-xs font-semibold text-zinc-500 group-hover:text-violet-300" title={verify}>
    <span class="sr-only">{verify}</span>↗
  </span>
</a>
